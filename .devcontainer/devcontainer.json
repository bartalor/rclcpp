{
    "name": "rclcpp-dev",
    "dockerComposeFile": ["compose.yaml", "compose.generated.yaml"],
    "service": "dev",
    "workspaceFolder": "${localWorkspaceFolder}",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "anthropic.claude-code"
            ],
            "settings": {
                "clangd.arguments": [
                    "--compile-commands-dir=/opt/overlay_ws/build/rclcpp",
                    "--path-mappings=/home/bar/src/ros2/rclcpp=/opt/overlay_ws/src/rclcpp/rclcpp"
                ]
            }
        }
    },
    "initializeCommand": ".devcontainer/host-setup.sh",
    "onCreateCommand": ".devcontainer/on-create-command.sh",
    "updateContentCommand": ".devcontainer/update-content-command.sh",
    "postCreateCommand": ".devcontainer/post-create-command.sh",
    "remoteUser": "ubuntu"
}
