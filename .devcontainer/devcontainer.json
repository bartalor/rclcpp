{
    "name": "rclcpp-dev",
    "privileged": true,
    "remoteUser": "bar",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "bar"
        }
    },
    "workspaceFolder": "/home/bar/src/ros2/rclcpp",
    "workspaceMount": "source=${localEnv:HOME}/src/ros2/rclcpp,target=/home/bar/src/ros2/rclcpp,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "anthropic.claude-code"
            ],
            "settings": {
                "clangd.arguments": [
                    "--compile-commands-dir=/home/ws/build/rclcpp"
                ]
            }
        }
    },
    "containerEnv": {
        "DISPLAY": "unix:0",
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
        "ROS_DOMAIN_ID": "42"
    },
    "remoteEnv": {
        "CCACHE_DIR": "/tmp/.ccache",
        "OVERLAY_MIXINS": "release ccache compile-commands lld"
    },
    "runArgs": [
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "-e", "DISPLAY=${env:DISPLAY}"
    ],
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/bar/.claude,type=bind",
        "source=${localEnv:HOME}/.claude/settings.json,target=/home/bar/.claude/settings.json,type=bind,readonly",
        "source=${localEnv:HOME}/.config/git/ignore,target=/home/bar/.config/git/ignore,type=bind,readonly",
        "source=${localEnv:HOME}/dotfiles,target=/home/bar/dotfiles,type=bind",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
        "source=rclcpp-workspace-${devcontainerId},target=/home/ws,type=volume",
        "source=ccache-${devcontainerId},target=/tmp/.ccache,type=volume"
    ],
    "onCreateCommand": "bash .devcontainer/on-create-command.sh",
    "updateContentCommand": "bash .devcontainer/update-content-command.sh",
    "postCreateCommand": "bash .devcontainer/post-create-command.sh"
}
