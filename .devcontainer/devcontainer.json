{
    "name": "rclcpp-dev",
    "privileged": true,
    "remoteUser": "bar",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "bar"
        }
    },
    "workspaceFolder": "/home/ws/src/rclcpp",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws/src/rclcpp,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "ms-iot.vscode-ros"
            ],
            "settings": {
                "clangd.arguments": [
                    "--compile-commands-dir=/home/ws/build/rclcpp"
                ]
            }
        }
    },
    "containerEnv": {
        "DISPLAY": "unix:0",
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
        "ROS_DOMAIN_ID": "42"
    },
    "runArgs": [
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "-e", "DISPLAY=${env:DISPLAY}"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached"
    ],
    "postCreateCommand": "sudo rosdep update && cd /home/ws && sudo rosdep install --from-paths src --ignore-src -y --skip-keys mimick_vendor && sudo chown -R $(whoami) /home/ws/"
}
